public class LargestDigit {
    public static void main(String[] args) {
        int n = 58329;  
        int large= 0;
        while (n > 0) {
            int d = n % 10;   
            if (d > large) {
                large = d;}
            n = n / 10;     
        }
        System.out.println("Largest digit is: " + large);
    }
}
