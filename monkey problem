import java.util.Scanner;

public class MonkeyTree {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter total number of monkeys (n): ");
        int n = sc.nextInt();
        System.out.print("Enter total number of bananas (m): ");
        int m = sc.nextInt();
        System.out.print("Enter total number of peanuts (p): ");
        int p = sc.nextInt();
        System.out.print("Enter bananas eaten by one monkey (k): ");
        int k = sc.nextInt();
        System.out.print("Enter peanuts eaten by one monkey (j): ");
        int j = sc.nextInt();
        int monkeysFed = 0;
        monkeysFed += m / k;   
        m = m % k;            
        monkeysFed += p / j;  
        p = p % j;             


        if ((m > 0) || (p > 0)) {
            monkeysFed++;
        }

        
        int monkeysLeft = n - monkeysFed;
        if (monkeysLeft < 0) {
            monkeysLeft = 0; 
        }

        System.out.println("Monkeys left on the tree: " + monkeysLeft);
    }
}
